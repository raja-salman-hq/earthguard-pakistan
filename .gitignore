# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/debug.log

# next.js
/.next/
/out/
/public/maplibre-gl-worker.mjs

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

debug.log
test-results/
playwright-report/

# raw scientific data: kept in Google Drive, never in Git
data/raw_exports/*
!data/raw_exports/.gitkeep
*.hdf5
*.HDF5
*.h5
*.hdf
*.nc
*.nc4
*.tif
*.tiff
*.zip
*.mp4
*.mov
.venv/
__pycache__/
.ipynb_checkpoints/

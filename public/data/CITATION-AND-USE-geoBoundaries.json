{"type":"Feature","geometry":null,"properties":{"====================================================":"boundarySourceURL -  A URL from which source data was retrieved."}},
{"type":"Feature","geometry":null,"properties":{"====================================================":"sourceDataUpdateDate - A date encoded following ISO 8601 (Year-Month-Date) describing the last date this boundary was updated"}},
{"type":"Feature","geometry":null,"properties":{"====================================================":"buildDate - The date the geoBoundary files were generated."}},
{"type":"Feature","geometry":null,"properties":{"====================================================":"downloadURL - A URL from which the geoBoundary can be downloaded."}},
